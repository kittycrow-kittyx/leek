{
  "name": "@kitty-crow/leek",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Leek Extends the Environment of KittyX. Ahead-of-time compiler for mikuOS.",
  "license": "MIT",
  "bin": {
    "leek": "src/cli.ts"
  },
  "scripts": {
    "leek": "bun src/cli.ts",
    "check": "bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test",
    "guards": "bun scripts/guards.ts",
    "guards:reuse": "bun scripts/reuse-guards.ts",
    "build": "bun run guards && bun run check",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "assemblyscript": "0.28.19",
    "binaryen": "130.0.0-nightly.20260609"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@kitty-crow/code-guards": "git+https://github.com/kitty-crow/code-guards.git#d1ce06c6b4a71e5f94ca97ba4b0f6780408aa3f6"
  },
  "engines": {
    "bun": ">=1.4.5"
  }
}
